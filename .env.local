# CosmicQA Environment Variables Example
# Copy this file to .env.local and configure your values

# API Configuration
NEXT_PUBLIC_API_URL=http://localhost:3004
NEXT_PUBLIC_WS_URL=ws://localhost:3004

# Server Configuration
PORT=3001
NODE_ENV=development

# Frontend Configuration
NEXT_PUBLIC_APP_NAME=CosmicQA
NEXT_PUBLIC_APP_VERSION=1.0.0

# Test Runner Configuration
DEFAULT_BROWSER=chromium
DEFAULT_HEADLESS=false
DEFAULT_TIMEOUT=30000
DEFAULT_VIEWPORT_WIDTH=1280
DEFAULT_VIEWPORT_HEIGHT=720

# Storage Paths (relative to server directory)
EXECUTIONS_DIR=./executions
SCREENSHOTS_DIR=./screenshots
VIDEOS_DIR=./videos
TESTS_DIR=./tests
SCHEDULED_TESTS_DIR=./scheduled-tests

# Cleanup Configuration (optional)
AUTO_CLEANUP_ENABLED=false
CLEANUP_RETENTION_DAYS=30
MAX_EXECUTION_FILES=1000

# Logging
LOG_LEVEL=info
ENABLE_DEBUG_LOGS=true
