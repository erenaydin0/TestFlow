# CosmicQA Environment Variables Example
# Copy this file to .env.local and configure your values

# ============================================================================
# SUPABASE CONFIGURATION (Required)
# ============================================================================

# Database connection (from Supabase Dashboard > Settings > Database)
DATABASE_URL=postgresql://postgres.[project-ref]:[password]@aws-0-[region].pooler.supabase.com:6543/postgres?pgbouncer=true
DIRECT_URL=postgresql://postgres.[project-ref]:[password]@aws-0-[region].pooler.supabase.com:5432/postgres

# Supabase API (from Supabase Dashboard > Settings > API)
NEXT_PUBLIC_SUPABASE_URL=https://[project-ref].supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJ...
SUPABASE_SERVICE_KEY=eyJ...

# ============================================================================
# NEXTAUTH CONFIGURATION (Required)
# ============================================================================

# Generate with: openssl rand -base64 32
NEXTAUTH_SECRET=your-secret-key-here

# For development
NEXTAUTH_URL=http://localhost:3000

# For production (Vercel will set this automatically)
# NEXTAUTH_URL=https://your-app.vercel.app

# ============================================================================
# APP CONFIGURATION
# ============================================================================

NODE_ENV=development

# Frontend Configuration
NEXT_PUBLIC_APP_NAME=CosmicQA
NEXT_PUBLIC_APP_VERSION=1.0.0

# ============================================================================
# LOCAL AGENT CONFIGURATION (Optional - for local test runner)
# ============================================================================

# Test Runner defaults
DEFAULT_BROWSER=chromium
DEFAULT_HEADLESS=false
DEFAULT_TIMEOUT=30000
DEFAULT_VIEWPORT_WIDTH=1280
DEFAULT_VIEWPORT_HEIGHT=720

# Logging
LOG_LEVEL=info
ENABLE_DEBUG_LOGS=true

# ============================================================================
# LEGACY (Deprecated - kept for reference)
# ============================================================================

# These are no longer used with Supabase architecture:
# NEXT_PUBLIC_API_URL - Use Supabase instead
# NEXT_PUBLIC_WS_URL - Use Supabase Realtime instead
# PORT - Handled by Vercel
# Storage paths - Use Supabase Storage instead
