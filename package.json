{
  "name": "CosmicQA",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "next lint",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:ui": "vitest --ui",
    "test:coverage": "vitest run --coverage",
    "server": "node --no-deprecation --import tsx server/core/index.ts",
    "server:dev": "nodemon --exec \"node --no-deprecation --import tsx\" server/core/index.ts",
    "dev:full": "concurrently \"npm run dev\" \"npm run server\""
  },
  "dependencies": {
    "@playwright/test": "^1.55.1",
    "@types/node": "^24.0.8",
    "@types/node-cron": "^3.0.11",
    "@types/react": "^19.1.8",
    "@types/react-datepicker": "^6.2.0",
    "@types/react-dom": "^19.1.6",
    "clsx": "^2.1.1",
    "cors": "^2.8.5",
    "croner": "^9.1.0",
    "date-fns": "^4.1.0",
    "dotenv": "^17.2.3",
    "eslint": "^9.30.0",
    "eslint-config-next": "^15.3.4",
    "express": "^4.18.2",
    "fs-extra": "^11.2.0",
    "i18next": "^25.5.3",
    "jszip": "^3.10.1",
    "lucide-react": "^0.525.0",
    "next": "^15.5.4",
    "next-i18next": "^15.4.2",
    "node-cron": "^4.2.1",
    "playwright": "^1.40.1",
    "react": "^19.1.0",
    "react-datepicker": "^8.7.0",
    "react-dom": "^19.1.0",
    "react-i18next": "^16.0.0",
    "recharts": "^3.0.2",
    "typescript": "^5.8.3",
    "uuid": "^9.0.1",
    "ws": "^8.14.2"
  },
  "devDependencies": {
    "@testing-library/jest-dom": "^6.6.3",
    "@testing-library/react": "^16.1.0",
    "@testing-library/user-event": "^14.5.2",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.5",
    "@types/fs-extra": "^11.0.4",
    "@types/jszip": "^3.4.0",
    "@types/uuid": "^10.0.0",
    "@types/ws": "^8.18.1",
    "@vitejs/plugin-react": "^4.3.4",
    "@vitest/coverage-v8": "^4.0.13",
    "@vitest/ui": "^4.0.13",
    "autoprefixer": "^10.4.21",
